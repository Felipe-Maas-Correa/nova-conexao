# Porta da API
PORT=4000

# Origem permitida (frontend)
# Em produção: https://novaconexao.net.br,https://www.novaconexao.net.br
CLIENT_ORIGIN=http://localhost:5173

# Contato
WHATSAPP_NUMBER=5555996556467
CONTACT_EMAIL=contato@novaconexao.net.br

# Avaliações reais do Google (opcional).
# Sem estas variáveis, o site usa os depoimentos locais.
# Como obter: ver seção "Avaliações do Google" no README.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Escuta só neste computador (o Nginx é quem recebe o público).
HOST=127.0.0.1

# Onde guardar os contatos recebidos pelo formulário (contatos.jsonl).
DATA_DIR=/var/lib/nova-conexao
